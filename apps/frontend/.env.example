# 로컬 개발용. 구글 연동 전까지 로그인 버튼이 이 토큰을 쓴다. 백엔드 JWT_SECRET으로 시드 유저({ sub })를 서명한 값.
# 비워 두면 'dev'가 들어가고 API 호출은 401로 실패한다. 실제 값은 .env.local(git 제외)에 둔다.
VITE_DEV_TOKEN=

# 개발 서버 프록시가 넘길 백엔드 주소. 비우면 http://localhost:3001
VITE_API_TARGET=

# 소스 화면이 보여 주는 받는 주소의 앞부분. 비우면 현재 주소 + /api (개발 프록시). 배포에서는 API 공개 주소
VITE_INGRESS_URL=

# 구글 로그인 클라이언트 ID(백엔드 GOOGLE_CLIENT_ID와 같은 값, 공개 값). 비우면 로그인 버튼이 VITE_DEV_TOKEN을 쓰는 개발용으로 동작한다
VITE_GOOGLE_CLIENT_ID=
